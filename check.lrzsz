#! /bin/sh

testdir="testdir.lrzsz"

srcdir="$1"
if test $srcdir = . ; then
    srcdir=`pwd`
fi
if test $srcdir = .. ; then
    srcdir=`pwd`/..
fi
objdir="$2"
if test $objdir = . ; then
    objdir=`pwd`
fi

echo checking with srcdir = $1 and objdir = $2

selectedtests=
if test "x$3" = x ; then
    mode=all
else
    mode=$3
    if test "$mode" = "select" ; then
        mode=all
        shift
        shift
        shift
        for i in "$@" ; do
            selectedtests="$selectedtests $i";
        done
    fi
fi

ECHO=echo 
if test -n "$QUIET" ; then
    ECHO=":"
fi

SZ="$objdir/src/lsz"
RZ="$objdir/src/lrz"
SNIF="$objdir/src/zmodemsnif"
SIMU="$objdir/src/linesimulator"
TIMESTAMP="$objdir/src/timestamp"


# z_test_files: files to test zmodem with.
# z8_test_files: files to test zmodem-8k with. Optional.
# y_test_files: files to test ymodem with.
# x_test_files: files to test xmodem with. Must be ascii, as we need the
#               ascii mode to remove the padding ^Zs.

# generate list of testfiles 
x_test_files=""
y_test_files=""
z_test_files=""
z8_test_files=""
for i in $srcdir/src/l?z.c ; do
	z_test_files="$z_test_files $i" 
	x_test_files="$x_test_files $i" 
done
for i in $objdir/src/l?z ; do
	z_test_files="$z_test_files $i" 
	y_test_files="$y_test_files $i" 
done
rm -f $objdir/null1 $objdir/null2
touch $objdir/null1 $objdir/null2
#x_test_files="$objdir/null1 $x_test_files" 
#y_test_files="$objdir/null1 $y_test_files" 
#z_test_files="$objdir/null1 $objdir/null2 $z_test_files" 
#z_test_files="$objdir/src/timing.h"

for i in $(ls -S /usr/lib | head -1) ; do
        z8_test_files="$z8_test_files /usr/lib/$i" 
done
for i in $(ls -S /usr/bin | head -1) ; do
        z8_test_files="$z8_test_files /usr/bin/$i" 
done
#z8_test_files="/usr/bin/nvim"

# change to tmp dir
if test "x$TMPDIR" = x ; then
	cd /tmp
else
	cd $TMPDIR || cd /tmp
fi

rm -rf $testdir
mkdir $testdir
exec 5>$testdir/error.log
(mkfifo $testdir/pipe || mknod $testdir/pipe p) 2>&5

runlog=$testdir/run.log
LRZSZ_JOURNAL=$(pwd)/$testdir/journal.log
TRACEFILE_SZ=$(pwd)/$testdir/trace-sz.txt
TRACEFILE_RZ=$(pwd)/$testdir/trace-rz.txt
export LRZSZ_JOURNAL

binary_1m=$(find /usr/bin/ /usr/lib -size +1100000c -a -size -5000000c |xargs ls -S1 | tail -n1)
dd if="$binary_1m" of="$testdir/binary_1m" bs=1024 count=1024 2>&5
binary_1m="$testdir/binary_1m"

binary_2m=$testdir/2m.bin
for i in $(seq 0 1) ; do
    cat $binary_1m >>$binary_2m
done

binary_8m=$testdir/8m.bin
for i in $(seq 0 7) ; do
    cat $binary_1m >>$binary_8m
done

# special files to test x/y binary transfers
all_256_file=$testdir/all256.bin
for i in $(seq 0 255); do printf "\\$(printf '%03o' "$i")"; done > $all_256_file

binary_256k=$testdir/256k.bin
dd if="$binary_1m" of="$binary_256k" bs=1024 count=256 2>&5
dd if="$all_256_file" of="$binary_256k" bs=1 seek=8192 conv=notrunc 2>&5

binary_128k=$testdir/128k.bin
dd if="$binary_1m" of="$binary_128k" bs=1024 count=128 2>&5
dd if="$all_256_file" of="$binary_128k" bs=1 seek=8192 conv=notrunc 2>&5

binary_64k=$testdir/64k.bin
dd if="$binary_1m" of="$binary_64k" bs=1024 count=64 2>&5
dd if="$all_256_file" of="$binary_64k" bs=1 seek=8192 conv=notrunc 2>&5

binary_32k=$testdir/32k.bin
dd if="$binary_1m" of="$binary_32k" bs=1024 count=32 2>&5
dd if="$all_256_file" of="$binary_32k" bs=1 seek=8192 conv=notrunc 2>&5

binary_16k=$testdir/16k.bin
dd if="$binary_1m" of="$binary_16k" bs=1024 count=16 2>&5
dd if="$all_256_file" of="$binary_16k" bs=1 seek=8192 conv=notrunc 2>&5

binary_8k=$testdir/8k.bin
dd if="$binary_1m" of="$binary_8k" bs=1024 count=8 2>&5
dd if="$all_256_file" of="$binary_8k" bs=1 seek=1024 conv=notrunc 2>&5

binary_4k=$testdir/4k.bin
dd if="$binary_1m" of="$binary_4k" bs=1024 count=4 2>&5
dd if="$all_256_file" of="$binary_4k" bs=1 seek=1024 conv=notrunc 2>&5

binary_2k=$testdir/2k.bin
dd if="$binary_1m" of="$binary_2k" bs=1024 count=2 2>&5
dd if="$all_256_file" of="$binary_2k" bs=1 seek=1024 conv=notrunc 2>&5

large_binary_file=$testdir/large.bin
sz=$(wc -c <$objdir/src/lsz)
blocks=$(expr $sz / 1024 )
dd if=$objdir/src/lsz of=$large_binary_file bs=1024 count=$blocks 2>&5


nocontrols_file=$testdir/nocontrols.txt
for i in $(seq 64 95); do printf "\\$(printf '%03o' "$i")"; done > $nocontrols_file
for i in $(seq 32 255); do printf "\\$(printf '%03o' "$i")"; done >> $nocontrols_file
#for i in $(seq 64 95); do printf "\\$(printf '%03o' "$i")"; done >> $nocontrols_file
#for i in $(seq 160 255); do printf "\\$(printf '%03o' "$i")"; done >> $nocontrols_file
# a real file for once:
man_file=$objdir/man/lsz.1
man_file_crlf=$testdir/lsz.1.crlf
man_file_crlf_padded_128=$testdir/lsz.1.crlf.padded_128
sed "s/\$/$(printf '\015')/" <$man_file >$man_file_crlf

cp $man_file_crlf $man_file_crlf_padded_128
sz=$(wc -c < $man_file_crlf)
pad=$(( 128 - (sz % 128) ))
[ $pad -eq 1024 ] && pad=0
[ $pad -gt 0 ] && dd if=/dev/zero bs=1 count=$pad 2>/dev/null | tr '\0' '\032' >>$man_file_crlf_padded_128

# $$ is the main, not the sub shell
getpid(){
    echo $(exec sh -c 'echo "$PPID"')
}
doit() {
    doit_key="$1"
    title="$2"
    sz="$3"
    rz="$4"
    cmp="$5"
    files="$6"

    if test "$ONLY" != "$doit_key" -a -n "$ONLY"; then
        # caller might have prepared something here.
        rm -rf $testdir/$doit_key 2>&5
        return
    fi
    if test -n "$selectedtests" ; then
        found=
        for t in $selectedtests ; do
            if test "$t" = "$doit_key" ; then
                found=t
            fi
        done
        if test -z "$found" ; then
            rm -rf $testdir/$doit_key 2>&5
            return
        fi
    fi
    mkdir $testdir/$doit_key 2>/dev/null
    $ECHO "$doit_key - $title"
    
    failed=0
    start=$($TIMESTAMP)
    
    MYSNIF=""
    if test -n "$ONLY" ; then
        MYSNIF="strace -vs 1280 -fo /tmp/sniff.trace $SNIF"
        MYSNIF="$SNIF"
    fi
    if test -n "$NOSNIF" ; then
        MYSNIF=""
    fi
    
    TRACE_SZ=""
    TRACE_RZ=""
    if test -n "$STRACE" ; then
        TRACE_SZ="strace -vs 1280 -Ttt -fo $TRACEFILE_SZ"
        TRACE_RZ="strace -vs 1280 -Ttt -fo $TRACEFILE_RZ"
    fi
#rz="$rz -vvvv";
    echo "$doit_key - $title" >>$runlog
    echo "pid: $$" >>$runlog
    echo "cmd: ($sz $files ) <$testdir/pipe | (cd $testdir/$doit_key ; exec $FAULT $MYSNIF $rz >>../pipe )" >>$runlog
        (echo "pid-sender: " $(getpid) >>$runlog ; exec $TRACE_SZ $sz $files ) <$testdir/pipe | 
        (echo "pid-receiver: $(getpid)" >>$runlog ; cd $testdir/$doit_key ; exec $FAULT $MYSNIF $TRACE_RZ $rz >>../pipe )
    end=$($TIMESTAMP)
    echo "cmp: $cmp" >>$runlog
    for doit_i in $files ; do 
            doit_bn=`basename $doit_i`
            _st="";
            _res="";
            if test -f $cmp ; then
                _res=" $testdir/$doit_key/$doit_bn = $cmp"
                cmp "$cmp" $testdir/$doit_key/$doit_bn
                _st=$?
            elif test "$cmp" = "missing" ; then
                _res=" $testdir/$doit_key/$doit_bn is missing as it should"
                test ! -e "$testdir/$doit_key/$doit_bn"
                _st=$?
            else
                _res=" $doit_i and $testdir/$doit_key/$doit_bn passed cmp function $cmp"
                $cmp "$doit_i" "$testdir/$doit_key/$doit_bn"
                _st=$?
            fi
            if test $_st -eq 0 ; then
                    echo "filecheck-success: $doit_i ($_res)" >>$runlog
                    rm -f $testdir/$doit_key/$doit_bn
            else
                    echo "filecheck-fail: $doit_i" >>$runlog
                    echo "stat original:" >>$runlog
                    if test -f $cmp ; then
                        stat $cmp | awk '{print "        " $0}' >>$runlog 
                    else
                        stat $doit_i | awk '{print "        " $0}' >>$runlog
                    fi
                    echo "stat received:" >>$runlog
                    stat $testdir/$doit_key/$doit_bn | awk '{print "        " $0}' >>$runlog
                    failed=1
            fi
    done
    if test $failed = 1 ; then 
            rmdir $testdir/$doit_key 2>&5
            echo "$doit_key FAILED"
            echo "---- see $testdir/run.log for more information"
            echo "summary: $doit_key FAILED" >>$runlog
            echo "summary: $doit_key FAILED" >>$testdir/failures.log
            any_failure="$any_failure $doit_key"
            echo "sender: $sz" >>$runlog
            echo "receiver: $sz" >>$runlog
    else
            rm -rf $testdir/$doit_key 2>&5
            $ECHO "$doit_key PASSED"
            echo "summary: $doit_key PASSED" >>$runlog
            bytes=0
            for doit_t in $files ; do
                # wc, because stat -f is not portable (OpenBSD, i greet you. And i hate you).
                bytes=$(expr $bytes + $(wc -c <$doit_t))
            done
            dur=$(echo "$end - $start" | bc)
            durshort=$(echo "scale=3; $end - $start" | bc)
            bps=$(echo "scale=2; $bytes / $dur" | bc)
            mbps=$(echo "scale=1; $bps / 1000000.0" | bc)
            if test "$mbps" = "0" ; then
                kbps=$(echo "scale=1; $bps / 1000.0" | bc)
                pres_bps="$kbps KB/s"
            else
                pres_bps="$mbps MB/s"
            fi
            echo "$bps byte/sec ($pres_bps): $doit_key, $bytes bytes transmitted in $durshort seconds" >>$testdir/perf.log
            echo "$bps byte/sec ($pres_bps): $doit_key, $bytes bytes transmitted in $durshort seconds" >>$runlog
    fi
    echo >>$runlog
}
resume_cmp() {
    if cmp "$1" "$2" >&5 ; then
        echo "---- receiver did not resume, but file is ok"
        return 0
    fi
    # $1 is the real file
    # $2 is the muddled file
    dir=$(dirname $2)
    bn=$(basename $2)
    dd if="$1" of="$dir/$bn"-cmp bs=256 count=5 2>&5
    dd if="$2" bs=256 skip=5 >>"$dir/$bn-cmp" 2>&5
    if cmp "$1" "$dir/$bn-cmp" >&5 ; then
        rm "$dir/$bn-cmp"
        return 0
    fi
    echo "-- sender resumed, but files differ. This is really bad."
    return 1
}
FAULTS="not slightly moderately noticeably significantly very extremely"
fault2num() {
    case "$1" in
    extremely) echo 1024 ; return ;;
    very) echo 2048 ; return ;;
    significantly) echo 4096 ; return ;;
    noticeably) echo 16384 ; return ;;
    moderately) echo 32768 ; return ;;
    slightly) echo 65536 ; return ;;
    *) echo 9999999999 ; return ;;
    esac
}

xerrors() {
    # start with the error handling tests
    for i in $FAULTS ; do
        # note: -f 1024 in average creates N errors per 1024 bytes,
        #   with N= number_of_channels * number_of_error_classes
        # 3 error classes (-e, -x, -g), 2 channels: 1 error every 170 bytes.

        # xmodem IS slow, and it is incredibly slow with many errors on the line.
        # switch to a smaller file with many errors.
        bin=$binary_128k
        if test $(fault2num $i) -lt 65536 ; then
            bin=$binary_16k
        fi
        if test $(fault2num $i) -lt 16384 ; then
            bin=$binary_4k
        fi
        bn=$(basename $bin)

        FAULT="$SIMU -s 1 -f $(fault2num $i) -r 8m -e 2 -x 4 -g 1" # flip up to 2 bits, drop up to 4 bytes, garble one byte. quite fast.
        app="-3e";
        if test "$i" = "not"; then
            app="";
        fi
        doit "xmodem-lsz-lrz-errorbase-crc-$i$app" "lsz sending to lrz, $i faulty line" "$SZ -q -X" "$RZ -q -b -X -c $bn" cmp "$bin" 

        # 1k mode CANNOT cope with to high error rates. it just needs to be able transfer some sectors…
        if test $(fault2num $i) -gt 2048  ; then
            doit "xmodem-lsz-lrz-errorbase-crc-1k-$i$app" "lsz sending to lrz, $i faulty line" "$SZ -q -X -k" "$RZ -q -b -X -c $bn" cmp "$bin" 
        fi

        # we repeat that with just 1 error class.
        if test "$i" != "not"; then
            FAULT="$SIMU -s 1 -f $(fault2num $i) -r 8m -e 1" # flip 1 bit. quite fast.
            doit "xmodem-lsz-lrz-errorbase-crc-$i-1e" "lsz sending to lrz, $i faulty line" "$SZ -q -X" "$RZ -q -b -X -c $bn" cmp "$bin" 
            if test $(fault2num $i) -gt 2048  ; then
                doit "xmodem-lsz-lrz-errorbase-crc-1k-$i-1e" "lsz sending to lrz, $i faulty line" "$SZ -q -X -k" "$RZ -q -b -X -c $bn" cmp "$bin" 
            fi
        fi

    done
    FAULT=
}
yerrors() {
    for i in $FAULTS ; do
        # note: -f 1024 in average creates N errors per 1024 bytes,
        #   with N= number_of_channels * number_of_error_classes
        # 3 error classes (-e, -x, -g), 2 channels: 1 error every 170 bytes.

        # xmodem IS slow, and it is incredibly slow with many errors on the line.
        # switch to a smaller file with many errors.
        bin="$binary_128k $binary_16k $binary_4k"
        if test $(fault2num $i) -lt 65536 ; then
            bin="$binary_16k $binary_4k"
        fi
        if test $(fault2num $i) -lt 16384 ; then
            bin="$binary_4k $all_256_file"
        fi

        FAULT="$SIMU -s 1 -f $(fault2num $i) -r 8m -e 2 -x 4 -g 1" # flip up to 2 bits, drop up to 4 bytes, garble one byte. quite fast.
        app="-3e";
        if test "$i" = "not"; then
            app="";
        fi
        doit "ymodem-lsz-lrz-errorbase-crc-$i$app" "lsz sending to lrz, $i faulty line" "$SZ -q -g" "$RZ -q -b -g -c" cmp "$bin"

        # 1k mode CANNOT cope with to high error rates. it just needs to be able transfer some sectors…
        if test $(fault2num $i) -gt 2048  ; then
            doit "ymodem-lsz-lrz-errorbase-crc-1k-$i$app" "lsz sending to lrz, $i faulty line" "$SZ -q -g -k" "$RZ -q -b -g -c" cmp "$bin" 
        fi

        # we repeat that with just 1 error class.
        if test "$i" != "not"; then
            FAULT="$SIMU -s 1 -f $(fault2num $i) -r 8m -e 1" # flip 1 bit. quite fast.
            doit "ymodem-lsz-lrz-errorbase-crc-$i-1e" "lsz sending to lrz, $i faulty line" "$SZ -q -g" "$RZ -q -b -g -c" cmp "$bin" 
            if test $(fault2num $i) -gt 2048  ; then
                doit "ymodem-lsz-lrz-errorbase-crc-1k-$i-1e" "lsz sending to lrz, $i faulty line" "$SZ -q -X -g" "$RZ -q -b -g -c" cmp "$bin" 
            fi
        fi

    done
    FAULT=
}
zerrors() {
    for thisfault in $FAULTS ; do

            # 
            speed=1m

            # note: -f 1024 in average creates N errors per 1024 bytes,
            #   with N= number_of_channels * number_of_error_classes
            # 3 error classes (-e, -x, -g), 2 channels: 1 error every 170 bytes.

            all_binaries="$binary_16k $binary_128k"
            case $speed in
            1m) all_binaries="$binary_16k $binary_128k";; 
            esac
            case "$thisfault" in
            extremely) all_binaries="$all_256_file $binary_2k" ;;
            very) all_binaries="$binary_2k $binary_4k" ;;
            significantly) all_binaries="$binary_4k $binary_8k" ;;
            noticeable) all_binaries="$binary_16k $binary_32k" ;;
            moderately) all_binaries="$binary_32k $binary_64k" ;;
            slightly) all_binaries="$binary_64k $binary_128k" ;;
            no) all_binaries="$binary_64k $binary_128k" ;;
            esac

    #        if test $(fault2num $thisfault) -lt 16384 ; then
    #            bin="$binary_4k $all_256_file"
    #        fi
            app="-3e";
            if test "$thisfault" = "not"; then
                app="";
            fi
            app="$app-$speed";

            FAULT="$SIMU -s 1 -f $(fault2num $thisfault) -r $speed -e 2 -x 4 -g 1" # flip up to 2 bits, drop up to 4 bytes, garble one byte. quite fast.
            doit "zmodem-lsz-lrz-errors-$thisfault$app" "lsz sending to lrz, $thisfault faulty line ($speed baud simulated)" "$SZ -q -Z" "$RZ -q -Z" cmp "$all_binaries"
            doit "zmodem-lsz-lrz-errors-4k-$thisfault$app" "lsz sending to lrz, $thisfault faulty line ($speed baud simulated)" "$SZ -q -4 -Z" "$RZ -q -Z" cmp "$all_binaries" 
            doit "zmodem-lsz-lrz-errors-8k-$thisfault$app" "lsz sending to lrz, $thisfault faulty line ($speed baud simulated)" "$SZ -q -8 -Z" "$RZ -q -Z" cmp "$all_binaries" 

            # we repeat that with just 1 error class.
            if test "$thisfault" != "not"; then
                FAULT="$SIMU -s 1 -f $(fault2num $thisfault) -r $speed -e 1" # flip 1 bit. quite fast.
                app="-1e";
                if test "$thisfault" = "not"; then
                    app="";
                fi
                app="$app-$speed";
                doit "zmodem-lsz-lrz-errors-$thisfault$app" "lsz sending to lrz, $thisfault faulty line ($speed baud simulated)" "$SZ -q -Z" "$RZ -q -Z" cmp "$all_binaries"
                doit "zmodem-lsz-lrz-errors-4k-$thisfault$app" "lsz sending to lrz, $thisfault faulty line ($speed baud simulated)" "$SZ -q -4 -Z" "$RZ -q -Z" cmp "$all_binaries" 
                doit "zmodem-lsz-lrz-errors-8k-$thisfault$app" "lsz sending to lrz, $thisfault faulty line ($speed baud simulated)" "$SZ -q -8 -Zk" "$RZ -q -Zc" cmp "$all_binaries" 
            fi
    done
    FAULT=
}

compat_traits() {
    other="$1"
    s_framelen_opt=""
    s_4k_opt=""
    s_8k_opt=""
    s_turno_opt=""
    r_error_opt=""
    r_ymodem_opt=""
    s_ymodem_opt=""
    r_xmodem_opt=""
    s_xmodem_opt=""
    r_xmodem_crc_opt=""
    r_can_xmodem_1k=""
    s_1k_opt=""
    r_ascii_opt="" 
    s_ascii_opt="" 
    r_binary_opt="" 
    r_resume_opt="" 
    s_resume_opt="" 
    s_append_opt="" 
    s_rename_opt="" 
    r_rename_opt="" 
    r_can_rename=""
    s_can_rename=""
    s_can_resume=""
    r_can_4k=""
    r_can_8k=""
    can_escctl=""
    s_16bit_crc_opt=""
    r_can_16bit_crc=""
    TEST_SZ=""
    TEST_SB=""
    TEST_SX=""
    TEST_RZ=""
    TEST_RB=""
    TEST_RX=""
    BENCH_SZ_1k=""
    BENCH_SZ_2k=""
    BENCH_SZ_4k=""
    BENCH_SZ_8k=""
    BENCH_RZ=""

    case "$other" in 
    self)
        BENCH_SZ_1k="$SZ -q"
        BENCH_SZ_2k=""
        BENCH_SZ_4k="$SZ -q -4"
        BENCH_SZ_8k="$SZ -q -8"
        BENCH_RZ="$RZ -q"
        TEST_SZ="$SZ -q"
        TEST_SB="$SZ -q -g"
        TEST_SX="$SZ -q -X"
        TEST_RZ="$RZ -q"
        TEST_RB="$RZ -q -g"
        TEST_RX="$RZ -q -X"
        s_framelen_opt=-l
        r_error_opt="-F" # lrzsz lrz option to create errors, short form
        r_ymodem_opt="-g" 
        s_ymodem_opt="-g" 
        r_xmodem_opt="-X" 
        s_xmodem_opt="-X" 
        r_xmodem_crc_opt="-c"
        r_can_xmodem_1k="yes"
        s_1k_opt="-k"
        r_ascii_opt="-a" 
        s_ascii_opt="-a" 
        r_binary_opt="-b" 
        r_resume_opt="-r" 
        s_resume_opt="-r" 
        s_append_opt="-+" 
        s_rename_opt="-E" 
        r_rename_opt="-E" 
        r_can_rename=yes
        s_can_rename=yes
        s_can_resume=yes
        r_can_4k="yes"
        r_can_8k="yes"
        otherrz="lrz"
        othersz="lsz"
        can_escctl="yes"
        s_16bit_crc_opt="-o"
        r_can_16bit_crc="yes"
        ;;
    lrzsz_old)
        TEST_SZ=~/bin/lrzsz-0.12.21rc/lsz" -q"
        TEST_SX=~/bin/lrzsz-0.12.21rc/lsz" -q --xmodem"
        TEST_SB=~/bin/lrzsz-0.12.21rc/lsz" -q --ymodem"
        TEST_RZ=~/bin/lrzsz-0.12.21rc/lrz" -q "
        TEST_RX=~/bin/lrzsz-0.12.21rc/lrz" -q --xmodem"
        TEST_RB=~/bin/lrzsz-0.12.21rc/lrz" -q --ymodem"
        BENCH_SZ_1k="$TEST_SZ"
        BENCH_SZ_2k=""
        BENCH_SZ_4k="$TEST_SZ -4"
        BENCH_SZ_8k="$TEST_SZ -8"
        BENCH_RZ="$TEST_RZ"
        s_framelen_opt=-l
        s_4k_opt="-4"
        s_8k_opt="-8"
        s_turno_opt="-T"
        r_error_opt="--errors" #lrzsz lrz option to create errors
        r_ymodem_opt="--ymodem"
        s_ymodem_opt="--ymodem"
        r_xmodem_opt="--xmodem"
        s_xmodem_opt="--xmodem"
        r_xmodem_crc_opt="-c"
        r_can_xmodem_1k="yes"
        s_1k_opt="-k"
        r_ascii_opt="-a" 
        s_ascii_opt="-a" 
        r_binary_opt="-b" 
        r_resume_opt="-r" 
        s_resume_opt="-r" 
        s_append_opt="-+" 
        s_rename_opt="-E" 
        r_rename_opt="-E" 
        r_can_rename=yes
        s_can_rename=yes
        s_can_resume=yes
        r_can_4k="yes"
        r_can_8k="yes"
        can_escctl="yes"
        otherrz="lrz(0.12.21rc)"
        othersz="lsz(0.12.21rc)"
        s_16bit_crc_opt="-o"
        r_can_16bit_crc="yes"
        ;;

    sexyz)
        TEST_SZ=~/bin/sexyz" -s sz"
        TEST_RZ=~/bin/sexyz" -s rz"
        TEST_SX=~/bin/sexyz" sx"
        TEST_RX=~/bin/sexyz" rx"
        TEST_SB=~/bin/sexyz" sy"
        TEST_RB=~/bin/sexyz" ry"
        otherrz="sexyz"
        othersz="sexyz"
        s_1k_opt="-k"
        r_can_4k="yes"
        r_can_8k="yes"
        s_4k_opt="-4"
        s_8k_opt="-8"
        r_binary_opt=" "  # always binary
        BENCH_SZ_1k="$TEST_SZ"
        BENCH_SZ_2k="$TEST_SZ -2"
        BENCH_SZ_4k="$TEST_SZ -4"
        BENCH_SZ_8k="$TEST_SZ -8"
        BENCH_RZ="$TEST_RZ"
        ;;
        
    crzsz)
        TEST_SZ=~/bin/crzsz/csz # no -q option
        TEST_SB=~/bin/crzsz/csb # no -q option
        TEST_SX=~/bin/crzsz/csx # no -q option
        TEST_RZ=~/bin/crzsz/crz
        TEST_RB=~/bin/crzsz/crb
        TEST_RX=~/bin/crzsz/crx
        otherrz="crz"
        othersz="csz"
        s_can_resume=yes
        can_escctl="yes"
        s_16bit_crc_opt="-o"
        r_can_16bit_crc="yes"
        s_1k_opt="-k"
        BENCH_SZ_1k="$TEST_SZ"
        BENCH_RZ="$TEST_RZ"
        ;;
    zmtxzmrx)
        TEST_SZ=~/bin/zmtx # no -q option
        TEST_RZ=~/bin/zmrx" -q"
        BENCH_SZ_1k="$TEST_SZ"
        BENCH_RZ="$TEST_RZ"
        otherrz="zmrx"
        othersz="zmtx"
        r_can_4k="yes"
        r_can_8k="yes"
        r_4k_opt="-q"
        #s_can_resume=  : ZCRC is not implemented.
        #can_escapectl= : ZESCCTL is not implemented
        ;;
    esac
}

xcompat() {
    available="self"
    if test -x ~/bin/lrzsz-0.12.21rc/lrz -a -x ~/bin/lrzsz-0.12.21rc/lsz ; then
        available="$available lrzsz_old"
    fi
    if test -x ~/bin/crzsz/crz -a -x ~/bin/crzsz/csz ; then
        available="$available crzsz"
    fi
    if test -x ~/bin/zmtx -a -x ~/bin/zmrx ; then
        available="$available zmtxzmrx"
    fi
    if test -x ~/bin/sexyz ; then
        available="$available sexyz"
    fi
    for other in $available; do
        compat_traits "$other"
        if test -n "$r_xmodem_opt" ; then
            bn=$(basename $all_256_file)
            test -n "$r_binary_opt" && \
                doit "xmodem-lsz-$otherrz-small-binary" "lsz sending to $otherrz" "$SZ -q -X" "$TEST_RX $r_binary_opt $bn" cmp "$all_256_file" 
            bn=$(basename $binary_16k)
            test -n "$r_binary_opt" && \
                doit "xmodem-lsz-$otherrz-16k-binary" "lsz sending to $otherrz" "$SZ -q -X" "$TEST_RX $r_binary_opt $bn" cmp "$binary_16k" 
            test -n "$r_binary_opt" && test -n "$r_xmodem_crc_opt" && \
                doit "xmodem-lsz-$otherrz-16k-binary-crc" "lsz sending to $otherrz" "$SZ -q -X" "$TEST_RX $r_xmodem_crc_opt $r_binary_opt $bn" cmp "$binary_16k" 

            bn=$(basename $large_binary_file)
            test -n "$r_binary_opt" && test -n "$r_can_xmodem_1k" && \
                doit "xmodem-lsz-$otherrz-large-binary-1k" "lsz sending to $otherrz" "$SZ -q -X -k" "$TEST_RX $r_binary_opt $bn" cmp "$large_binary_file" 
            test -n "$r_binary_opt" && test -n "$r_can_xmodem_1k" && test -n "$r_xmodem_crc_opt" && \
                doit "xmodem-lsz-$otherrz-large-binary-1k-crc" "lsz sending to $otherrz" "$SZ -q -X -k" "$TEST_RX $r_xmodem_crc_opt $r_binary_opt $bn" cmp "$large_binary_file" 
            bn=$(basename $binary_1m)
            test -n "$r_binary_opt" && test -n "$r_can_xmodem_1k" && test -n "$r_xmodem_crc_opt" && \
                doit "xmodem-lsz-$otherrz-megabyte-binary-1k-crc" "lsz sending to $otherrz" "$SZ -q -X -k" "$TEST_RX $r_xmodem_crc_opt $r_binary_opt $bn" cmp "$binary_1m" 

            bn=$(basename $nocontrols_file)
            test -n "$r_ascii_opt" && \
                doit "xmodem-lsz-$otherrz-small-ascii" "lsz sending to $otherrz" "$SZ -q -X" "$TEST_RX $r_ascii_opt $bn" cmp "$nocontrols_file" 
            bn=$(basename $man_file)
            test -n "$r_ascii_opt" && \
                doit "xmodem-lsz-$otherrz-medium-ascii" "lsz sending to $otherrz" "$SZ -q -X" "$TEST_RX  $r_ascii_opt $bn" cmp "$man_file" 
            test -n "$r_ascii_opt" && test -n "$r_xmodem_crc_opt" && \
                doit "xmodem-lsz-$otherrz-medium-ascii-crc" "lsz sending to $otherrz" "$SZ -q -X" "$TEST_RX $r_xmodem_crc_opt $r_ascii_opt $bn" cmp "$man_file" 
            test -n "$r_ascii_opt" && test -n "$r_can_xmodem_1k" && \
                doit "xmodem-lsz-$otherrz-medium-ascii-1k" "lsz sending to $otherrz" "$SZ -k -q -X" "$TEST_RX $r_ascii_opt $bn" cmp "$man_file" 
            test -n "$r_ascii_opt" && test -n "$r_xmodem_crc_opt" && test -n "$r_can_xmodem_1k" && \
                doit "xmodem-lsz-$otherrz-medium-ascii-1k-crc" "lsz sending to $otherrz" "$SZ -q -k -X" "$TEST_RX $r_xmodem_crc_opt $r_ascii_opt $bn" cmp "$man_file" 

            # sender -a option: \n => \r\n. because, well, featuritis?
            # problem: rz -a removes the \r again. rz -b adds ^Zs. so we use a padded comparison file.
            if test -n "$r_binary_opt"; then
                bn=$(basename $man_file)
                doit "xmodem-lsz-$otherrz-medium-crlf" "lsz sending to $otherrz" "$SZ -a -q -X" "$TEST_RX $r_binary_opt $bn" "$man_file_crlf_padded_128" "$man_file" 
            fi

        fi

        if test "$other" != "self" -a -n "$TEST_SX"; then
            bn=$(basename $all_256_file)
            doit "xmodem-$othersz-lrz-small-binary" "XMODEM: small binary transfer: $othersz sending to lrz" "$TEST_SX -b" "$RZ -q -X -b $bn" cmp "$all_256_file" 

            bn=$(basename $binary_16k)
            doit "xmodem-$othersz-lrz-16k-binary" "XMODEM: 16k binary transfer: $otherrz sending to lrz" "$TEST_SX" "$RZ -q -X -b  $bn" cmp "$binary_16k" 
            doit "xmodem-$othersz-lrz-16k-binary-crc" "XMODEM/CRC: 16k binary transfer: $otherrz sending to lrz" "$TEST_SX" "$RZ -q -X -b -c  $bn" cmp "$binary_16k" 

            bn=$(basename $large_binary_file)
            test -n "$s_1k_opt" && \
                doit "xmodem-$othersz-lrz-large-binary-1k" "XMODEM/1k: large binary transfer: $otherrz sending to lrz" "$TEST_SX $s_1k_opt" "$RZ -q -X -b $bn" cmp "$large_binary_file" 
            test -n "$s_1k_opt" && \
                doit "xmodem-$othersz-lrz-large-binary-1k-crc" "XMODEM/1k/CRC: large binary transfer: $otherrz sending to lrz" "$TEST_SX $s_1k_opt" "$RZ -q -X -b -c $bn" cmp "$large_binary_file" 
            bn=$(basename $binary_1m)
            test -n "$s_1k_opt" && \
                doit "xmodem-$othersz-lrz-megabyte-binary-1k-crc" "XMODEM/1k/CRC: megabyte binary transfer: $otherrz sending to lrz" "$TEST_SX $s_1k_opt" "$RZ -q -X -b -c $bn" cmp "$binary_1m" 

            bn=$(basename $nocontrols_file)
            doit "xmodem-$othersz-lrz-small-ascii" "XMODEM: small ascii transfer: $otherrz sending to lrz" "$TEST_SX" "$RZ -q -X -a $bn" cmp "$nocontrols_file" 
            bn=$(basename $man_file)
            doit "xmodem-$othersz-lrz-medium-ascii" "XMODEM: medium ascii transfer: $otherrz sending to lrz" "$TEST_SX" "$RZ -q -X -a $bn" cmp "$man_file" 
            doit "xmodem-$othersz-lrz-medium-ascii-crc" "XMODEM/CRC: medium ascii transfer: $otherrz sending to lrz" "$TEST_SX" "$RZ -q -X -c -a $bn" cmp "$man_file" 

            bn=$(basename $man_file)
            test -n "$s_1k_opt" && \
                doit "xmodem-$othersz-lrz-medium-ascii-1k" "XMODEM/1k: medium ascii transfer: $otherrz sending to lrz" "$TEST_SX $s_1k_opt" "$RZ -q -X -a $bn" cmp "$man_file" 
            test -n "$s_1k_opt" && \
                doit "xmodem-$othersz-lrz-medium-ascii-1k-crc" "XMODEM/1k/CRC: medium ascii transfer: $otherrz sending to lrz" "$TEST_SX $s_1k_opt" "$RZ -q -X -c -a $bn" cmp "$man_file" 

            bn=$(basename $man_file)
            test -n "$s_ascii_opt" && \
                doit "xmodem-$othersz-lrz-medium-crlf" "XMODEM CR/LF conversion: medium ascii transfer: $otherrz sending to lrz" "$TEST_SX $s_ascii_opt" "$RZ -q -X -b $bn" "$man_file_crlf_padded_128" "$man_file" 
        fi
    done
}
ycompat() {
    available="self"
    if test -x ~/bin/lrzsz-0.12.21rc/lrz -a -x ~/bin/lrzsz-0.12.21rc/lsz ; then
        available="$available lrzsz_old"
    fi
    if test -x ~/bin/crzsz/crz -a -x ~/bin/crzsz/csz ; then
        available="$available crzsz"
    fi
    if test -x ~/bin/zmtx -a -x ~/bin/zmrx ; then
        available="$available zmtxzmrx"
    fi
    if test -x ~/bin/sexyz ; then
        available="$available sexyz"
    fi
    for other in $available; do
        compat_traits "$other"
        # we here assume the Y is implemented like X. Which is quite reasonable.
        # we also assume that all programs transfer binary by default. rzsz and descendants do, and to do something else would be stupid.
        # we also do NO ascii tests.
        all_binaries="$all_256_file $binary_16k $binary_128k $binary_256k $binary_1m"
        if test -n "$TEST_RB" ; then
            doit "ymodem-lsz-$otherrz-small-binary" "lsz sending to $otherrz" "$SZ -q -g" "$TEST_RB" cmp "$all_256_file" 
            doit "ymodem-lsz-$otherrz-16k-binary" "lsz sending to $otherrz" "$SZ -q -g" "$TEST_RB" cmp "$binary_16k" 

            # the next one checks the transfer of multiple files. we do another one with CRC and 1k.
            doit "ymodem-lsz-$otherrz-multiple" "lsz sending to $otherrz" "$SZ -q -g" "$TEST_RB" cmp "$all_binaries" 

            test -n "$r_xmodem_crc_opt" && doit "ymodem-lsz-$otherrz-crc" "lsz sending to $otherrz" "$SZ -q -g" "$TEST_RB $r_xmodem_crc_opt" cmp "$binary_256k" 
            test -n "$r_can_xmodem_1k" && doit "ymodem-lsz-$otherrz-1k" "lsz sending to $otherrz" "$SZ -q -g -k" "$TEST_RB" cmp "$binary_256k" 

            # second multiple file test
            test -n "$r_can_xmodem_1k" && test -n "$r_xmodem_crc_opt" && \
                doit "ymodem-lsz-$otherrz-1k-crc-multiple" "lsz sending to $otherrz" "$SZ -q -g -k" "$TEST_RB $r_xmodem_crc_opt" cmp "$all_binaries" 
        fi

        if test "$other" != "self" -a -n "$TEST_SB"; then
            doit "ymodem-$othersz-lrz-small-binary" "$othersz sending to lrz" "$TEST_SB -b" "$RZ -q -g -b" cmp "$all_256_file" 
            doit "ymodem-$othersz-lrz-16k-binary" "$otherrz sending to lrz" "$TEST_SB" "$RZ -q -g -b " cmp "$binary_16k" 

            doit "ymodem-$othersz-lrz-multiple" "$otherrz sending to lrz" "$TEST_SB" "$RZ -q -g -b " cmp "$all_binaries" 

            doit "ymodem-$othersz-lrz-crc" "$otherrz sending to lrz" "$TEST_SB" "$RZ -q -g -b -c " cmp "$binary_256k" 
            test -n "$s_1k_opt" && \
                doit "ymodem-$othersz-lrz-1k" "$otherrz sending to lrz" "$TEST_SB $s_1k_opt" "$RZ -q -g -b" cmp "$binary_256k" 

            test -n "$s_1k_opt" && \
                doit "ymodem-$othersz-lrz-1k-crc-multiple" "$otherrz sending to lrz" "$TEST_SB $s_1k_opt" "$RZ -q -g -b" cmp "$all_binaries" 
        fi
    done
}
zcompat() {
    available="self"
    if test -x ~/bin/lrzsz-0.12.21rc/lrz -a -x ~/bin/lrzsz-0.12.21rc/lsz ; then
        available="$available lrzsz_old"
    fi
    if test -x ~/bin/crzsz/crz -a -x ~/bin/crzsz/csz ; then
        available="$available crzsz"
    fi
    if test -x ~/bin/zmtx -a -x ~/bin/zmrx ; then
        available="$available zmtxzmrx"
    fi
    if test -x ~/bin/sexyz ; then
        available="$available sexyz"
    fi
    for other in $available; do
        compat_traits "$other"
        # we also assume that all programs transfer binary by default. rzsz and descendants do, and to do something else would be stupid.
        # we also do NO ascii tests. ASCII conversion should die, die, die. We will test it in lrzsz specific test, though
        all_binaries="$all_256_file $binary_4k $binary_16k $binary_128k $binary_256k $binary_1m"
        doit "zmodem-lsz-$otherrz-multiple" "lsz sending multiple files to $otherrz" "$SZ -q" "$TEST_RZ" cmp "$all_binaries" 
        doit "zmodem-lsz-$otherrz-framelen-512" "lsz sending with framelen 512 to $otherrz" "$SZ -q -l 512" "$TEST_RZ" cmp "$all_binaries" 
        doit "zmodem-lsz-$otherrz-framelen-128" "lsz sending with framelen 256 to $otherrz" "$SZ -q -l 128" "$TEST_RZ" cmp "$all_binaries" 
        test -n "$r_can_4k" && doit "zmodem-lsz-$otherrz-4k" "lsz tries to send 4k blocks to $otherrz" "$SZ -q -4" "$TEST_RZ" cmp "$all_binaries" 
        test -n "$r_can_4k" && doit "zmodem-lsz-$otherrz-4kstart" "lsz starts to send 4k blocks to $otherrz" "$SZ -q -5" "$TEST_RZ" cmp "$all_binaries" 
        test -n "$r_can_8k" && doit "zmodem-lsz-$otherrz-8k" "lsz tries to send 8k blocks to $otherrz" "$SZ -q -8" "$TEST_RZ" cmp "$all_binaries" 
        test -n "$r_can_8k" && doit "zmodem-lsz-$otherrz-8kstart" "lsz starts to send 8k blocks to $otherrz" "$SZ -q -9" "$TEST_RZ" cmp "$all_binaries" 
        doit "zmodem-lsz-$otherrz-turbo" "lsz sending with turbo escaping to $otherrz" "$SZ -qT" "$TEST_RZ" cmp "$all_binaries" 
        test -n "$r_can_8k" && doit "zmodem-lsz-$otherrz-8k-turbo" "lsz tries to send 4k block with turbo escaping to $otherrz" "$SZ -qT -8" "$TEST_RZ" cmp "$all_binaries" 
        test -n "$can_escctl" && doit "zmodem-lsz-$otherrz-escape-s" "lsz sending with escaped control chars to $otherrz (sender initiated)" "$SZ -q -e" "$TEST_RZ" cmp "$all_binaries" 
        test -n "$r_can_16bit_crc" && doit "zmodem-lsz-$otherrz-crc16" "lsz sending with CRC16 to $otherrz" "$SZ -q -o" "$TEST_RZ" cmp "$all_binaries" 
        if test -n "$s_resume_opt" ; then
            key="zmodem-lsz-$otherrz-RESUME-s"
            mkdir $testdir/$key 2>/dev/null|| true
            dd if=$srcdir/src/Makefile.in of=$testdir/$key/lsz.c bs=256 count=5 2>&5
            doit "$key" "lsz sending (resuming) to $other" "$SZ -rq" "$TEST_RZ" resume_cmp $srcdir/src/lsz.c 

            key="zmodem-lsz-$otherrz-RESUME-CRC-s"
            mkdir $testdir/$key 2>/dev/null|| true
            dd if=$srcdir/src/Makefile.in of=$testdir/$key/lsz.c bs=256 count=5 2>&5
            doit "$key" "lsz sending (resuming with CRC -H) to $other" "$SZ -rqH" "$TEST_RZ" cmp $srcdir/src/lsz.c 

            key="zmodem-lsz-$otherrz-RESUME-CRC2-s"
            mkdir $testdir/$key 2>/dev/null|| true
            dd if=$srcdir/src/Makefile.in of=$testdir/$key/lsz.c bs=256 count=5 2>&5
            doit "$key" "lsz sending (resuming with CRC -rr) to $other" "$SZ -rqr" "$TEST_RZ" cmp $srcdir/src/lsz.c 
        fi
        if test -n "$r_resume_opt" ; then
            key="zmodem-lsz-$otherrz-RESUME-r"
            mkdir $testdir/$key 2>/dev/null|| true
            dd if=$srcdir/src/Makefile.in of=$testdir/$key/lsz.c bs=256 count=5 2>&5
            doit "$key" "lsz sending to $other (resuming)" "$SZ -q" "$TEST_RZ $r_resume_opt" resume_cmp $srcdir/src/lsz.c 
            # could check against the receivers CRC options - but why should i check them?
        fi
        if test "$other" != "self" ; then
            doit "zmodem-$othersz-lrz-multiple" "$othersz sending multiple files to lrz" "$TEST_SZ" "$RZ -q" cmp "$all_binaries" 
            test "$s_opt_framelen" = 1 && doit "zmodem-$othersz-lrz-framelen-512" "$othersz sending with framelen 512 to lrz" "$TEST_SZ $s_opt_framelen 512" "$RZ -q" cmp "$all_binaries" 
            test "$s_opt_framelen" = 1 && doit "zmodem-$othersz-lrz-framelen-128" "$othersz sending with framelen 512 to lrz" "$TEST_SZ $s_opt_framelen 128" "$RZ -q" cmp "$all_binaries" 
            test -n "$s_4k_opt" && doit "zmodem-$othersz-lrz-4k" "$othersz tries to send 4k blocks to lrz" "$TEST_SZ $s_4k_opt" "$RZ -q" cmp "$all_binaries" 
            test -n "$s_8k_opt" && doit "zmodem-$othersz-lrz-8k" "$othersz tries to send 8k blocks to lrz" "$TEST_SZ $s_8k_opt" "$RZ -q" cmp "$all_binaries" 
            test -n "$s_turbo_opt" && doit "zmodem-$othersz-lrz-turbo" "$othersz sending with turbo escaping to lrz" "$TEST_SZ $s_turbo_opt" "$RZ -q" cmp "$all_binaries" 
            test -n "$s_turbo_opt" && test -n "$s_8k_opt" && \
                doit "zmodem-$othersz-lrz-8k-8k-turbo" "$othersz sending 8k blocks with turbo escaping to lrz" "$TEST_SZ $s_turbo_opt $s_8k_opt" "$RZ -q" cmp "$all_binaries" 
            test -n "$can_escapectl" && doit "zmodem-$othersz-lrz-escape-r" "$othersz sending with escaped control characters to lrz (receiver initialized)" "$TEST_SZ" "$RZ -q -e" cmp "$all_binaries" 
            test -n "$s_16bit_crc_opt" && doit "zmodem-$othersz-lrz-crc16" "$othersz sending with CRC16 to lrz" "$TEST_SZ $s_16bit_crc_opt" "$RZ -q -e" cmp "$all_binaries" 

            key=zmodem-$othersz-lrz-resume-r
            mkdir $testdir/$key 2>/dev/null|| true
            dd if=$srcdir/src/Makefile.in of=$testdir/$key/lsz.c bs=256 count=5 2>&5
            doit "$key" "$othersz sending to lsz (tries to resume)" "$TEST_SZ" "$RZ -qr" resume_cmp $srcdir/src/lsz.c 

            if test -n "$s_can_resume" ; then
                key=zmodem-$othersz-lrz-resume-crc-r
                mkdir $testdir/$key 2>/dev/null|| true
                dd if=$srcdir/src/Makefile.in of=$testdir/$key/lsz.c bs=256 count=5 2>&5
                doit "$key" "$othersz sending to lsz (resuming with -H)" "$TEST_SZ" "$RZ -qrH" cmp $srcdir/src/lsz.c 

                key=zmodem-$othersz-lrz-resume-crc2-r
                mkdir $testdir/$key 2>/dev/null|| true
                dd if=$srcdir/src/Makefile.in of=$testdir/$key/lsz.c bs=256 count=5 2>&5
                doit "$key" "$othersz sending to lsz (resuming with -rr)" "$TEST_SZ" "$RZ -qrr" cmp $srcdir/src/lsz.c 
            fi

            if test -n "$s_resume_opt" ; then
                key=zmodem-$othersz-lrz-resume-r
                mkdir $testdir/$key 2>/dev/null|| true
                dd if=$srcdir/src/Makefile.in of=$testdir/$key/lsz.c bs=256 count=5 2>&5
                doit "$key" "$othersz sending with resume to lrz" "$TEST_SZ $s_resume_opt" "$RZ -q" resume_cmp $srcdir/src/lsz.c 
            fi
        fi

    done
}
zbuffer() {
    compat_traits "self"
    _SZ_1k="$BENCH_SZ_1k";
    _RZ="$BENCH_RZ";
    sender="lsz"
    receiver="lrz"
    for i in $(seq 1 7); do
            for speed in unlimited; do
                FAULT=""
                all_binaries="$all_256_file $binary_4k $binary_16k $binary_128k $binary_256k $binary_1m $binary_8m"

                key="zmodem-$sender-$receiver-buffer-4096"
                doit "$key" "$sender sending multiple files to $receiver" "$_SZ_1k" "$_RZ -B4096" cmp "$all_binaries" 
                key="zmodem-$sender-$receiver-buffer-8192"
                doit "$key" "$sender sending multiple files to $receiver" "$_SZ_1k" "$_RZ -B8192" cmp "$all_binaries" 
                key="zmodem-$sender-$receiver-buffer-16384"
                doit "$key" "$sender sending multiple files to $receiver" "$_SZ_1k" "$_RZ -B16384" cmp "$all_binaries" 
                key="zmodem-$sender-$receiver-buffer-32768"
                doit "$key" "$sender sending multiple files to $receiver" "$_SZ_1k" "$_RZ -B32768" cmp "$all_binaries" 
                key="zmodem-$sender-$receiver-buffer-65536"
                doit "$key" "$sender sending multiple files to $receiver" "$_SZ_1k" "$_RZ -B65536" cmp "$all_binaries" 
                key="zmodem-$sender-$receiver-buffer-131072"
                doit "$key" "$sender sending multiple files to $receiver" "$_SZ_1k" "$_RZ -B131072" cmp "$all_binaries" 
                key="zmodem-$sender-$receiver-buffer-262144"
                doit "$key" "$sender sending multiple files to $receiver" "$_SZ_1k" "$_RZ -B262144" cmp "$all_binaries" 
            done
            
    done
}
# for the benchmarking.
config() {
    case "$1" in
    self|lrzsz)
        shift
        _cmd=
        _opt=
        for _i in $* ; do
            case "$_i" in
            sx) _cmd=$SZ" -q -X" ;;
            sy) _cmd=$SZ" -q -g" ;;
            sz) _cmd=$SZ" -q" ;;
            rx) _cmd=$RZ" -q -X" ;;
            ry) _cmd=$RZ" -q -g" ;;
            rz) _cmd=$RZ" -q" ;;
            crc) _opt="$_opt -c" ;;
            crc16) _opt="$_opt -o" ;;
            1k) _opt="$_opt -k" ;;
            4k) _opt="$_opt -4" ;;
            8k) _opt="$_opt -8" ;;
            turbo) _opt="$_opt -T" ;;
            r_can_2k) ;;
            r_can_4k) ;;
            r_can_8k) ;;
            *) echo "" ; return ;;
            esac
        done
        echo $_cmd $_opt
        return
        ;;
    lrzsz_old)
        shift
        _cmd=
        _opt=
        for _i in $* ; do
            case "$_i" in
            sx) _cmd=~/bin/lrzsz-0.12.21rc/lsz" -q --xmodem" ;;
            ry) _cmd=~/bin/lrzsz-0.12.21rc/lsz" -q --ymodem" ;;
            sz) _cmd=~/bin/lrzsz-0.12.21rc/lsz" -q" ;;
            rx) _cmd=~/bin/lrzsz-0.12.21rc/lrz" -q --xmodem" ;;
            ry) _cmd=~/bin/lrzsz-0.12.21rc/lrz" -q --ymodem" ;;
            rz) _cmd=~/bin/lrzsz-0.12.21rc/lrz" -q" ;;
            crc) _opt="$_opt -c" ;;
            crc16) _opt="$_opt -o" ;;
            1k) _opt="$_opt -k" ;;
            4k) _opt="$_opt -4" ;;
            8k) _opt="$_opt -8" ;;
            turbo) _opt="$_opt -T" ;;
            r_can_2k) ;;
            r_can_4k) ;;
            r_can_8k) ;;
            *) echo "" ; return ;;
            esac
        done
        echo $_cmd $_opt
        return
        ;;
    crzsz)
        shift
        _cmd=
        _opt=
        for _i in $* ; do
            case "$_i" in
            sx) _cmd=~/bin/crzsz/csx ;;
            sy) _cmd=~/bin/crzsz/csb ;;
            sz) _cmd=~/bin/crzsz/csz ;;
            rx) _cmd=~/bin/crzsz/crx ;;
            ry) _cmd=~/bin/crzsz/crb ;;
            rz) _cmd=~/bin/crzsz/crz ;;
            r_can_2k) ;;
            crc16) _opt="$_opt -o" ;;
            1k) _opt="$_opt -k" ;;
            *) echo "" ; return ;;
            esac
        done
        echo $_cmd $_opt
        return;
        ;;
    zmtxzmrx)
        shift
        _cmd=
        for _i in $* ; do
            case "$_i" in
            r_can_2k) ;;
            r_can_4k) ;;
            r_can_8k) ;;
            sz) _cmd=~/bin/zmtx ;;
            rz) _cmd=~/bin/zmrx" -q" ;;
            *) echo "" ; return ;;
            esac
        done
        echo $_cmd
        return;
        ;;
    sexyz)
        shift
        _cmd=~/bin/sexyz
        _post=~/bin/sexyz
        for _i in $* ; do
            case "$_i" in
            r_can_2k) ;;
            r_can_4k) ;;
            r_can_8k) ;;
            8k) _cmd="$_cmd -8" ;;
            4k) _cmd="$_cmd -4" ;;
            2k) _cmd="$_cmd -2" ;;
            1k) _cmd="$_cmd -k" ;;
            crc) _cmd="$_cmd -c" ;;
            crc16) _cmd="$_cmd -o" ;;
            segmented) _cmd="$_cmd -s" ;;
            sz) _post="sz" ;;
            rz) _post="rz" ;;
            sy) _post="sy" ;;
            ry) _post="ry" ;;
            sx) _post="sx" ;;
            rx) _post="rx" ;;
            *) echo "" ; return ;;
            esac
        done
        echo $_cmd $_post
        return
        ;;
    esac
}
zbenchmark() {
    available="self"
    if test -x ~/bin/lrzsz-0.12.21rc/lrz -a -x ~/bin/lrzsz-0.12.21rc/lsz ; then
        available="$available lrzsz_old"
    fi
    if test -x ~/bin/crzsz/crz -a -x ~/bin/crzsz/csz ; then
        available="$available crzsz"
    fi
    if test -x ~/bin/zmtx -a -x ~/bin/zmrx ; then
        available="$available zmtxzmrx"
    fi
    if test -x ~/bin/sexyz ; then
        available="$available sexyz"
    fi
    if false ; then
        for sender in $available ; do
            echo "sender $sender sz  =" $(config $sender sz)
            echo "receiver $sender rz  =" $(config $sender rz)
            echo "sender $sender sz 4k =" $(config $sender sz 4k)
            echo "receiver $sender rz r_can_4k =" $(config $sender rz r_can_4k)
        done
        return
    fi
    #for speed in unlimited 8m 1m 115200 38400 25ms 20ms 15ms 10ms 5ms 2ms; do
    for speed in unlimited 115200 38400 25ms 20ms ; do
        for kparm in "" 2k 4k 8k ; do
            for sender in $available ; do
                for receiver in $available ; do
                    # blacklist of known problem combos
                    case "$sender-$receiver" in
                    zmtxzmrx-crzsz)
                        # crzsz for some reason falls back to XMODEM.
                        continue;
                        ;;
                    sexyz-zmtxzmrx)
                        # sexyz stumbles (a) over the ZACK zmrx sends for ZFILE, and (b) over the wrong ZACK position in other ZACKs.
                        continue;
                        ;;
                    esac
            
                    TEST_S=$(config $sender sz $kparm)
                    if test -z "$TEST_S" ; then continue ; fi
                    t=""
                    if test -n "$kparm" ; then
                        t="r_can_$kparm"
                    fi
                    TEST_R=$(config $receiver rz $t)
                    if test -z "$TEST_R" ; then continue ; fi

                    case "$speed" in
                    unlimited) FAULT="" ;;
                    *ms) FAULT="strace -vs 1280 -Ttt -o /tmp/o77 $SIMU -s 1 -d $speed -b 128" ;;
                    *) FAULT="$SIMU -s 1 -r $speed" ;;
                    esac
                    #echo "FAULT=$FAULT for $speed"

                    case "$speed" in
                    38400) all_binaries="$all_256_file $binary_2k $binary_8k " ;;
                    115200) all_binaries="$all_256_file $binary_2k $binary_4k $binary_8k $binary_16k" ;;
                    2ms) all_binaries="$all_256_file $binary_4k $binary_16k $binary_32k $binary_256k" ;;
                    5ms) all_binaries="$all_256_file $binary_8k $binary_16k $binary_64k" ;;
                    10ms) all_binaries="$all_256_file $binary_8k $binary_32k" ;;
                    15ms) all_binaries="$all_256_file $binary_8k $binary_16k" ;;
                    20ms) all_binaries="$all_256_file $binary_4k $binary_16k" ;;
                    25ms) all_binaries="$all_256_file $binary_2k $binary_16k" ;;
                    *ms) all_binaries="$all_256_file $binary_4k $binary_16k $binary_128k $binary_256k" ;;
                    1m) all_binaries="$all_256_file $binary_2k $binary_4k $binary_8k $binary_16k $binary_256k" ;;
                    8m) all_binaries="$all_256_file $binary_2k $binary_4k $binary_8k $binary_16k $binary_32k $binary_64k $binary_128k $binary_256k $binary_2m" ;;
                    *) all_binaries="$all_256_file $binary_4k $binary_16k $binary_128k $binary_256k $binary_1m $binary_8m" ;;
                    esac
                    #echo speed="$speed" bins="$all_binaries"

                    t="1k"
                    if test -n "$kparm" ; then
                        t="$kparm"
                    fi
                    key="zmodem-$sender-$receiver-benchmark-$speed-$t"
                    doit "$key" "$sender sending multiple files to $receiver" "$TEST_S" "$TEST_R" cmp "$all_binaries" 
                done
            done

        done
    done
}
zmanage() {

    # this is deliberatly limited to lrzsz alone.
    # - zmtx only implements newer, clobber and protect.
    # - crzsz implements most or all, but crz doesn't have options for them (csz has).
    # i decided against testing against other zmodems here, because
    # a) interoperability shouldn't be a problem (all these are just header flags)
    # b) i would need three flags (in the already long list above) per management option:
    # -- "senders XXX option."
    # -- "receivers XXX option."
    # -- "receiver can handle XXX, if the sender initializes it."
    #    multiply that by CRC, NEW, NEWL, APND, CLOB, DIFF, PROT, CHNG…
    # c) i'd bet there are logical differences in the implementations.
    # notes:
    # - ZMDIFF isn't implemented anywhere.
    # - ZMCRC has to be tested as part of the resume handling, too.

    # first check the defaults
    # - lrz does create a not existing target.
    # - lrz does NOT overwrite an existing file without a ZMCLOB
    key="zmodem-lsz-lrz-MGMT-default-nonexisting"
    doit "$key" "lsz sending to lrz does create file" "$SZ -q" "$RZ -q" "$testdir/$key/all256.bin" $all_256_file

    # check the opposite: a file of the same name and the same size is not overwritten
    key="zmodem-lsz-lrz-MGMT-default-existing"
    mkdir "$testdir/$key"
    cp $all_256_file $testdir/$key/16k.bin # this one is smaller
    touch -d 2001-02-03T04:05:06.07 $testdir/16k.bin # this one is old.
    cp $testdir/$key/16k.bin $testdir/$key/cmp
    doit "$key" "lsz sending to lrz does not overwrite existing file" "$SZ -q" "$RZ -q" "$testdir/$key/cmp" $binary_16k
    #
    # test ZMNEW (5), ZMNEWL (1)
    # ZMNEWL is only partially tested (size), as it falls through to ZMNEW.
    #
    key="zmodem-lsz-lrz-MGMT-ZMNEW-fail-s"
    mkdir "$testdir/$key"
    cp $all_256_file $testdir/$key/test.bin
    cp $binary_16k $testdir/test.bin
    touch -d 2001-02-03T04:05:06.07 $testdir/test.bin # this one is old.
    doit "$key" "lsz sending to lrz fails (sender initialized)" "$SZ -q -n" "$RZ -q" $all_256_file "$testdir/test.bin" 

    key="zmodem-lsz-lrz-MGMT-ZMNEW-success-s"
    mkdir "$testdir/$key"
    cp $all_256_file $testdir/$key/test.bin
    touch -d 2001-02-03T04:05:06.07 $testdir/$key/test.bin # this one is old.
    cp $binary_16k $testdir/test.bin
    doit "$key" "lsz sending to lrz succeeds (sender initialized)" "$SZ -q -n" "$RZ -q" $binary_16k "$testdir/test.bin" 

    key="zmodem-lsz-lrz-MGMT-ZMNEWL-succes-s"
    mkdir "$testdir/$key"
    cp $all_256_file $testdir/$key/test.bin
    cp $binary_16k $testdir/test.bin
    touch -d 2001-02-03T04:05:06.07 $testdir/test.bin # this one is old.
    doit "$key" "lsz sending to lrz succeeds (sender initialized)" "$SZ -q -N" "$RZ -q" $binary_16k "$testdir/test.bin" 

    key="zmodem-lsz-lrz-MGMT-ZMNEW-fail-r"
    mkdir "$testdir/$key"
    cp $all_256_file $testdir/$key/test.bin
    cp $binary_16k $testdir/test.bin
    touch -d 2001-02-03T04:05:06.07 $testdir/test.bin # this one is old.
    doit "$key" "lsz sending to lrz fails (receiver initialized)" "$SZ -q" "$RZ -q -n" $all_256_file "$testdir/test.bin" 

    key="zmodem-lsz-lrz-MGMT-ZMNEW-success-r"
    mkdir "$testdir/$key"
    cp $all_256_file $testdir/$key/test.bin
    touch -d 2001-02-03T04:05:06.07 $testdir/$key/test.bin # this one is old.
    cp $binary_16k $testdir/test.bin
    doit "$key" "lsz sending to lrz succeeds (receiver initialized)" "$SZ -q" "$RZ -q -n" $binary_16k "$testdir/test.bin" 

    key="zmodem-lsz-lrz-MGMT-ZMNEWL-success-r"
    mkdir "$testdir/$key"
    cp $all_256_file $testdir/$key/test.bin
    cp $binary_16k $testdir/test.bin
    touch -d 2001-02-03T04:05:06.07 $testdir/test.bin # this one is old, but longer
    doit "$key" "lsz sending to lrz fails (receiver initialized)" "$SZ -q" "$RZ -q -N" $binary_16k "$testdir/test.bin" 

    #
    # ZMCRC (2)
    #

    # first we check that lrz without -H somewhere does keep the modified file.
    key="zmodem-lsz-lrz-MGMT-noZMCRC-s"
    mkdir "$testdir/$key"
    cp $all_256_file $testdir/$key/
    printf '\x41' | dd of=$testdir/$key/all256.bin bs=1 seek=32 conv=notrunc 2>&5
    cp $testdir/$key/all256.bin $testdir/$key/cmp
    doit "$key" "lsz sending to lrz does not overwrite (sender initialized)" "$SZ -q" "$RZ -q" "$testdir/$key/cmp" $all_256_file

    key="zmodem-lsz-lrz-MGMT-ZMCRC-s"
    mkdir "$testdir/$key"
    cp $all_256_file $testdir/$key/
    printf '\x41' | dd of=$testdir/$key/all256.bin bs=1 seek=32 conv=notrunc 2>&5
    doit "$key" "lsz sending to lrz overwrites (sender initialized)" "$SZ -qH" "$RZ -q" cmp $all_256_file

    key="zmodem-lsz-lrz-MGMT-ZMCRC-r"
    mkdir "$testdir/$key"
    cp $all_256_file $testdir/$key/
    printf '\x41' | dd of=$testdir/$key/all256.bin bs=1 seek=32 conv=notrunc 2>&5
    doit "$key" "lsz sending to lrz overwrites (receiver initialized)" "$SZ -q" "$RZ -q -H" cmp $all_256_file

    #
    # ZMAPND (3)
    # receiver appends to the target, if it exists
    # the doc does not specify if the target shall be created if it doesn't exists,
    # but in practice it is (the 1988s code changed the fopen mode from "w" to "a", and omen also does this).
    #
    key="zmodem-lsz-lrz-MGMT-ZMAPND-s"
    mkdir $testdir/$key 2>/dev/null|| true
    cp $srcdir/src/Makefile.in $testdir/$key/lsz.c
    cat $srcdir/src/Makefile.in $srcdir/src/lsz.c >>$testdir/$key/cmp
    doit "$key" "ZMODEM/MGMT/ZMAPND: lsz sending to $other" "$SZ -q -+" "$RZ -q" "$testdir/$key/cmp" $srcdir/src/lsz.c 

    key="zmodem-lsz-lrz-MGMT-ZMAPND-r"
    mkdir $testdir/$key 2>/dev/null|| true
    cp $srcdir/src/Makefile.in $testdir/$key/lsz.c
    cat $srcdir/src/Makefile.in $srcdir/src/lsz.c >>$testdir/$key/cmp
    doit "$key" "ZMODEM/MGMT/ZMAPND: $othersz sending to lrz" "$SZ" "$RZ -q -+" "$testdir/$key/cmp" $srcdir/src/lsz.c 

    #
    # ZMCLOB (4)
    # we check in the ZMCRC test that the file would normally be skipped.
    #
    key="zmodem-lsz-lrz-MGMT-ZMCLOB-s"
    mkdir "$testdir/$key"
    printf '\x41' | dd of=$testdir/$key/all256.bin bs=1 seek=32 conv=notrunc 2>&5
    doit "$key" "lsz -y sending to lrz (sender initialized)" "$SZ -q -y" "$RZ -q" "$all_256_file" $all_256_file

    key="zmodem-lsz-lrz-MGMT-ZMCLOB-r"
    mkdir "$testdir/$key"
    printf '\x41' | dd of=$testdir/$key/all256.bin bs=1 seek=32 conv=notrunc 2>&5
    doit "$key" "lsz sending to lrz -y (receiver initialized)" "$SZ -q" "$RZ -q -y" "$all_256_file" $all_256_file

    #
    # ZMDIFF (6)
    #   Transfer file if destination file absent.  Otherwise, transfer file 
    #   overwriting destination if files have different lengths or dates. 
    # This is not implemented anywhere, not even in crzsz
    #

    #
    # ZMPROT (7)
    #
    key="zmodem-lsz-lrz-MGMT-ZMPROT-s"
    mkdir "$testdir/$key"
    touch $testdir/$key/all256.bin
    touch $testdir/$key/null
    doit "$key" "lsz sending to lrz (sender initialized)" "$SZ -q -p" "$RZ -q" "$testdir/$key/null" $all_256_file
    key="zmodem-lsz-lrz-MGMT-ZMPROT-r"
    mkdir "$testdir/$key"
    touch $testdir/$key/all256.bin
    touch $testdir/$key/null
    doit "$key" "lsz sending to lrz (receiver initialized)" "$SZ -q" "$RZ -q -p" "$testdir/$key/null" $all_256_file

    #
    # ZMCHNG (8)
    #
    key="zmodem-lsz-lrz-MGMT-ZMCHNG-s"
    mkdir "$testdir/$key"
    cp $all_256_file $testdir/$key/
    doit "$key" "lsz sending to lrz (sender initialized)" "$SZ -q -E" "$RZ -q" "$testdir/$key/all256.bin.0" $all_256_file
    key="zmodem-lsz-lrz-MGMT-ZMCHNG-r"
    mkdir "$testdir/$key"
    cp $all_256_file $testdir/$key/
    doit "$key" "lsz sending to lrz (received initialized)" "$SZ -q" "$RZ -q -E" "$testdir/$key/all256.bin.0" $all_256_file

    # there also is this:
    # define ZF1_ZMSKNOLOC   0x80 /* Skip file if not present at rx */ (alternatively written as ZF1ZMSKNOLOC)
    # lrzsz sets this if lsz is given the -Y (overwrite or skip) option.
    key="zmodem-lsz-lrz-MGMT-ZMSKNOLOC-nonexisting"
    doit "$key" "lsz sending to lrz does not create file if does not exist" "$SZ -q -Y" "$RZ -q" "missing" $all_256_file

    key="zmodem-lsz-lrz-MGMT-ZMSKNOLOC-existing"
    mkdir "$testdir/$key"
    touch $testdir/$key/all256.bin
    doit "$key" "lsz sending to lrz does update file if it does exist" "$SZ -q -Y" "$RZ -q" "$all_256_file" $all_256_file
}


echo "mode=$mode"
if test "$mode" = all -o "$mode" = xerrors -o "$mode" = "errors" -o "$mode" = "x" ; then
    xerrors
fi
if test "$mode" = all -o "$mode" = yerrors -o "$mode" = "errors" -o "$mode" = "y" ; then
    yerrors
fi
if test "$mode" = all -o "$mode" = zerrors -o "$mode" = "errors" -o "$mode" = "z" ; then
    zerrors
fi
if test "$mode" = all -o "$mode" = xcompat -o "$mode" = "compat" -o "$mode" = "x" ; then
    xcompat
fi
if test "$mode" = all -o "$mode" = ycompat -o "$mode" = "compat" -o "$mode" = "y" ; then
    ycompat
fi
if test "$mode" = all -o "$mode" = zcompat -o "$mode" = "compat" -o "$mode" = "z" ; then
    zcompat
fi
if test "$mode" = all -o "$mode" = zmanage -o "$mode" = "z" ; then
    zmanage
fi
# not part of the normal self test, this is just too slow
if test "$mode" = zbenchmark  -o "$mode" = "benchmark" ; then
    zbenchmark
fi
if test "$mode" = zbuffer ; then
    # benchmark if the setvbuf default of 32768 is ok.
    # very special stuff, not a regular self check.
    zbuffer
fi



if test -s "$testdir/failures.log" ; then
    echo "Some tests failed. See $testdir/failures.log and $testdir/run.log"
    exit 1
fi
echo "All primary tests passed.\n";

if test "$mode" = all -o "$mode" = abuse ; then
    if test -z "$ONLY" ; then
	echo "going to tests misuse. Errors are ok, hangs are not!"

	echo "both sides sending:"
	$SZ -q $z_test_files <$testdir/pipe | \
		($SZ -q $z_test_files >>$testdir/pipe )

	echo "both sides receiving:"
	$RZ -q <$testdir/pipe | \
		( $RZ -q >>$testdir/pipe )
    fi
fi
echo "All tests passed.\n";
exit 0
